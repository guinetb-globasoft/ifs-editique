# =====================================================================
# Éditiques IFS — variables d'environnement
# Copier ce fichier en .env et le renseigner. .env n'est JAMAIS commité.
# =====================================================================

# --- IFS Cloud --------------------------------------------------------
# L'instance est lue dans l'URL et affichée : gafr-tst -> TST, gafr -> PROD.
IFS_BASE_URL=https://gafr-cfg.ifs.cloud
IFS_REALM=pisacfg1

# Client Keycloak qui porte le login des utilisateurs (authorization code +
# PKCE). Il doit déclarer IFS_OIDC_REDIRECT_URI dans ses « Valid redirect
# URIs », au caractère près, barre oblique finale comprise.
# Le client « POCs » de CFG déclare déjà http://localhost:8000/auth/ifs/callback/
# (posé pour ga-commande le 04/09/2026) : en local sur CFG, il suffit.
IFS_CLIENT_ID=
IFS_CLIENT_SECRET=
IFS_OIDC_REDIRECT_URI=http://localhost:8000/auth/ifs/callback/
IFS_OIDC_SCOPE=openid

# Signature du cookie de session (state anti-CSRF, identifiant de session).
# Vide = secret aléatoire au démarrage : suffit en local, pas en hébergement.
SESSION_SECRET=

# --- Compte technique (facultatif) -------------------------------------
# Client Keycloak en client_credentials, AVEC un utilisateur de service IFS
# rattaché (sans lui : ORA-20105 Login.FUSRNULL) et un rôle de lecture du type
# GAIFS_RF_ARMONY. Il lit ce qu'un acheteur n'ouvre pas : SIRET, logo, phrases
# ACH04/ACH05, CGA, coordonnées du coordinateur. Vide = ces lectures partent avec
# le jeton de l'utilisateur, et /donnees liste ce qui manque.
# Indispensable au branchement sur l'impression (IFS appelle sans utilisateur) :
# sur CFG, le client d'Armony, ARMONY_SVC (D-009).
IFS_TECH_CLIENT_ID=
IFS_TECH_CLIENT_SECRET=

# --- Impression IFS (D-009) ----------------------------------------------
# Le serveur Armony auquel relayer ce que l'application ne produit pas : la
# valeur d'origine du paramètre IFS ARMONY_SERVER.
ARMONY_RELAIS=https://armony-qua.ga.fr/AxData_Rec

# --- Éditiques --------------------------------------------------------
# Langue des libellés (colonne du fichier de libellés) et des textes IFS.
EDITIQUE_LANGUE=fr
